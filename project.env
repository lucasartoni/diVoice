# Project settings shared by the build and release scripts (sourced by scripts/common.sh).
# This is the single place to change them.

# Copyright holder shown in LICENSE (scripts/render-license.sh) and in the app's "About" text.
COPYRIGHT_HOLDER=Tommaso Seita
COPYRIGHT_YEAR=2026

# Official builds: Developer ID team and notarytool keychain profile.
# The bundle id (app.wibo.divoice, in app/Resources/Info.plist) and the team must never change:
# macOS ties permissions and Keychain access to them.
TEAM_ID=UGKAG4UL9P
NOTARY_PROFILE=divoice-notary

# Public repository that hosts the releases and the Sparkle appcast.
GITHUB_REPO=tommasoseita/diVoice
